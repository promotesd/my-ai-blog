---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Resume" />
  <Breadcrumbs items={[{ label: 'Resume', icon: 'lucide:file-user' }]} />

  <section class="space-y-8">
    <div class="rounded-lg border p-6">
      <h1 class="mb-3 text-2xl font-medium">张林奕涵</h1>
      <p class="text-muted-foreground text-sm leading-7">
        AI / Remote Sensing Researcher. 关注遥感图像理解、多模态学习、
        视觉语言模型、RAG 与语义分割。
      </p>
    </div>

    <div>
      <h2 class="mb-4 text-xl font-medium">Education</h2>
      <div class="rounded-lg border p-6">
        <h3 class="font-medium">本科阶段</h3>
        <p class="text-muted-foreground mt-2 text-sm leading-7">
          研究兴趣集中在人工智能、计算机视觉、遥感图像理解与多模态学习。
        </p>
      </div>
    </div>

    <div>
      <h2 class="mb-4 text-xl font-medium">Research Interests</h2>
      <div class="grid gap-3 md:grid-cols-2">
        <div class="rounded-lg border p-4 text-sm">遥感图像语义分割</div>
        <div class="rounded-lg border p-4 text-sm">视觉语言模型</div>
        <div class="rounded-lg border p-4 text-sm">多模态 RAG</div>
        <div class="rounded-lg border p-4 text-sm">遥感图文检索</div>
      </div>
    </div>

    <div>
      <h2 class="mb-4 text-xl font-medium">Projects</h2>
      <div class="space-y-4">
        <div class="rounded-lg border p-6">
          <h3 class="font-medium">SegEarth-R1 多模态分割扩展</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-7">
            围绕视觉语言分割、box decoder、元素定位、query-text 对齐等方向进行实验和改进。
          </p>
        </div>

        <div class="rounded-lg border p-6">
          <h3 class="font-medium">GeoMoE 遥感图文检索</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-7">
            研究参数高效 Mixture-of-Experts 与地理先验引导路由机制在遥感图文检索中的应用。
          </p>
        </div>

        <div class="rounded-lg border p-6">
          <h3 class="font-medium">慢病用药小管家</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-7">
            设计慢病用药管理 Web 应用的信息架构与关键交互流程。
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>