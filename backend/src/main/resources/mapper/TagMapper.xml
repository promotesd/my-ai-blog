<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaodudu.blog.mapper.TagMapper">
  <select id="findAll" resultType="com.xiaodudu.blog.entity.Tag">
    SELECT * FROM tag ORDER BY name ASC
  </select>
  <select id="findById" resultType="com.xiaodudu.blog.entity.Tag">
    SELECT * FROM tag WHERE id = #{id}
  </select>
  <insert id="insert" parameterType="com.xiaodudu.blog.entity.Tag" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO tag (name, slug) VALUES (#{name}, #{slug})
  </insert>
  <update id="update" parameterType="com.xiaodudu.blog.entity.Tag">
    UPDATE tag SET name = #{name}, slug = #{slug} WHERE id = #{id}
  </update>
  <delete id="deleteById">
    DELETE FROM tag WHERE id = #{id}
  </delete>
</mapper>
