<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaodudu.blog.mapper.ResumeMapper">
  <select id="findVisible" resultType="com.xiaodudu.blog.entity.ResumeSection">
    SELECT * FROM resume_section WHERE visible = 1 ORDER BY sort_order ASC, id ASC
